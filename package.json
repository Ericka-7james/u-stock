{
  "name": "u-stock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test:reddit-auth": "node scripts/test-reddit-auth.mjs",
    "fetch:reddit-mentions": "node scripts/fetch-reddit-mentions.mjs",
    "script": "node",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:frontend": "vitest run",
    "test:backend": "pytest",
    "test:all": "npm run test:frontend -- --coverage && npm run test:backend",
    "lint": "eslint . --ext .js,.jsx --max-warnings=0",
    "format": "prettier \"src/**/*.{js,jsx,json,css,md}\" --check",
    "format:fix": "prettier \"src/**/*.{js,jsx,json,css,md}\" --write",
    "symbols:update": "PYTHONPATH=src python -m data_scout.update_symbols"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "prettier": "^3.6.2",
    "vite": "^7.2.2",
    "vitest": "^4.0.10"
  }
}
