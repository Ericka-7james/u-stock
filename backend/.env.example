# backend/.env.example

ENV=local

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption for stored integration secrets (Fernet key)
INTEGRATIONS_ENC_KEY=

# Alpaca (optional if you store per-user keys in Supabase integrations table)
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex

# Cookie domain for multi-subdomain deployments (optional)
USTOCK_COOKIE_DOMAIN=

# Auth password policy (optional overrides)
AUTH_PASSWORD_MIN_LEN=12
AUTH_PASSWORD_REQUIRE_UPPER=true
AUTH_PASSWORD_REQUIRE_LOWER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true
AUTH_PASSWORD_FORBID_EMAIL=true
AUTH_PASSWORD_FORBID_USERNAME=true
