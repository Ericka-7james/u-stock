# ======================
# Environment
# ======================
# local | development | staging | production
ENV=development

# Comma-separated allowed origins
USTOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ======================
# Supabase
# ======================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BATCH_SIZE=100

SUPABASE_EVENTS_TABLE=bot_events
SUPABASE_BUCKET=market-snapshots

# ======================
# Auth / Bot Runner
# ======================
RUNNER_USER_ID=
BOT_RUNNER_SECRET=
PIPELINE_SECRET=
BOT_RUNNER_JWT_TTL_SECONDS=
BOT_RUNNER_JWT_SECRET=

# ======================
# Encryption
# ======================
# Fernet key for encrypting stored integration secrets
INTEGRATIONS_ENC_KEY=

# ======================
# Alpaca
# ======================
ALPACA_DATA_BASE=https://data.alpaca.markets

# Safety guard — MUST be false unless explicitly enabling live trading
ALLOW_LIVE_TRADING=false

# ======================
# Turnstile (bot protection)
# ======================
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# ======================
# Email / Feedback
# ======================
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM=
PUBLIC_LOGO_URL=

# ======================
# External APIs
# ======================
FRED_API_KEY=

# ======================
# Runner / Infra
# ======================
SERVER_IP=

# Cookie domain for multi-subdomain deployments (optional)
USTOCK_COOKIE_DOMAIN=

# Auth password policy (optional overrides)
AUTH_PASSWORD_MIN_LEN=12
AUTH_PASSWORD_REQUIRE_UPPER=true
AUTH_PASSWORD_REQUIRE_LOWER=true
AUTH_PASSWORD_REQUIRE_DIGIT=true
AUTH_PASSWORD_REQUIRE_SPECIAL=true
AUTH_PASSWORD_FORBID_EMAIL=true
AUTH_PASSWORD_FORBID_USERNAME=true
